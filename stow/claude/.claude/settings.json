{
  "cleanupPeriodDays": 90,
  "permissions": {
    "allow": [
      "Skill(update-config)",
      "Read",
      "Edit",
      "Write",
      "Glob",
      "Grep",
      "WebSearch",
      "WebFetch(domain:crates.io)",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:docs.rs)",
      "WebFetch(domain:www.mail-archive.com)",
      "WebFetch(domain:api.github.com)",
      "WebFetch(domain:code.claude.com)",
      "WebFetch(domain:stackoverflow.com)",
      "WebFetch(domain:developer.mozilla.org)",
      "WebFetch(domain:docs.python.org)",
      "WebFetch(domain:docs.aws.amazon.com)",
      "WebFetch(domain:registry.terraform.io)",
      "WebFetch(domain:pypi.org)",
      "WebFetch(domain:www.npmjs.com)",
      "WebFetch(domain:wikipedia.org)",
      "WebFetch(domain:en.wikipedia.org)",
      "WebFetch(domain:www.rust-lang.org)",
      "WebFetch(domain:doc.rust-lang.org)",
      "WebFetch(domain:pkg.go.dev)",
      "WebFetch(domain:learn.microsoft.com)",
      "WebFetch(domain:*.apache.org)",
      "WebFetch(domain:raw.githubusercontent.com)",
      "mcp__aws",
      "Bash(\\gh pr view:*)",
      "Bash(\\gh pr list:*)",
      "Bash(\\gh pr diff:*)",
      "Bash(\\gh pr create:*)",
      "Bash(\\gh pr checks:*)",
      "Bash(\\gh pr status:*)",
      "Bash(\\gh issue view:*)",
      "Bash(\\gh issue list:*)",
      "Bash(\\gh issue status:*)",
      "Bash(\\gh repo view:*)",
      "Bash(\\gh run view:*)",
      "Bash(\\gh run list:*)",
      "Bash(\\gh release view:*)",
      "Bash(\\gh release list:*)",
      "Bash(\\gh search:*)",
      "Bash(git -C *)",
      "Bash(git fetch:*)"
    ],
    "ask": [
      "Bash(/opt/homebrew/bin/aws-vault:*)",
      "Bash(aws-vault:*)",
      "Read(~/.aws/**)",
      "Read(~/.ssh/**)",
      "Read(~/.config/gh/**)",
      "Read(~/.cargo/credentials.toml)",
      "Read(~/.claude/.credentials.json)",
      "Read(~/.netrc)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Edit(~/.claude/settings.json)",
      "Write(~/.claude/settings.json)",
      "Edit(~/.claude/settings.local.json)",
      "Write(~/.claude/settings.local.json)",
      "Edit(~/.claude/CLAUDE.md)",
      "Write(~/.claude/CLAUDE.md)",
      "Edit(~/.claude/hooks/**)",
      "Write(~/.claude/hooks/**)",
      "Edit(~/.claude/agents/**)",
      "Write(~/.claude/agents/**)",
      "Edit(~/code/bashconfig/stow/claude/.claude/settings.json)",
      "Write(~/code/bashconfig/stow/claude/.claude/settings.json)",
      "Edit(~/code/bashconfig/stow/claude/.claude/settings.local.json)",
      "Write(~/code/bashconfig/stow/claude/.claude/settings.local.json)",
      "Edit(~/code/bashconfig/stow/claude/.claude/CLAUDE.md)",
      "Write(~/code/bashconfig/stow/claude/.claude/CLAUDE.md)",
      "Edit(~/code/bashconfig/stow/claude/.claude/hooks/**)",
      "Write(~/code/bashconfig/stow/claude/.claude/hooks/**)",
      "Edit(~/code/bashconfig/stow/claude/.claude/agents/**)",
      "Write(~/code/bashconfig/stow/claude/.claude/agents/**)"
    ],
    "defaultMode": "auto",
    "additionalDirectories": [
      "~/.m2",
      "~/.gradle",
      "~/Documents/notes",
      "~/code",
      "/tmp/",
      "~/.cargo",
      "~/.claude/projects"
    ]
  },
  "model": "eu.anthropic.claude-sonnet-4-6[1m]",
  "skillOverrides": {
    "commit": "name-only"
  },
  "hooks": {
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 /Users/mattias.johansson/.claude/hooks/autonomous-autoblock.py"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 /Users/mattias.johansson/.claude/hooks/autonomous-magicword.py"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 /Users/mattias.johansson/.claude/hooks/no-killgissa.py"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 /Users/mattias.johansson/.claude/hooks/block-compound-bash.py"
          },
          {
            "type": "command",
            "command": "python3 /Users/mattias.johansson/.claude/hooks/block-gh-comments.py"
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 /Users/mattias.johansson/.claude/hooks/check-code-rules.py"
          }
        ]
      },
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "python3 /Users/mattias.johansson/.claude/hooks/require-subagent-why.py"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "echo '{\"hookSpecificOutput\":{\"hookEventName\":\"SessionStart\",\"additionalContext\":\"Deferred-tool pre-load: in your first tool batch this session, call ToolSearch with query \\\"select:TaskCreate,TaskUpdate,EnterPlanMode,WebFetch,WebSearch,AskUserQuestion,Monitor\\\" to load schemas for these tools before using them, so calls do not fail with InputValidationError (\\\"unknown type string\\\").\"}}'"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "python3 /Users/mattias.johansson/.claude/hooks/statusline.py",
    "refreshInterval": 1
  },
  "enabledPlugins": {
    "skill-creator@claude-plugins-official": true,
    "slack@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "claude-plugins-official": {
      "source": {
        "source": "github",
        "repo": "anthropics/claude-plugins-official"
      }
    }
  },
  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": true,
    "allowUnsandboxedCommands": false,
    "network": {
      "allowedDomains": [
        "api.socket.dev",
        "crates.io",
        "github.com",
        "docs.rs",
        "www.mail-archive.com",
        "api.github.com",
        "code.claude.com",
        "stackoverflow.com",
        "developer.mozilla.org",
        "docs.python.org",
        "docs.aws.amazon.com",
        "registry.terraform.io",
        "pypi.org",
        "www.npmjs.com",
        "wikipedia.org",
        "en.wikipedia.org",
        "www.rust-lang.org",
        "doc.rust-lang.org",
        "pkg.go.dev",
        "learn.microsoft.com",
        "*.apache.org",
        "raw.githubusercontent.com",
        "localhost:4566",
        "localhost:8181",
        "mcp.slack.com"
      ]
    },
    "filesystem": {
      "allowWrite": [
        "/var/folders",
        "/private/var/folders",
        "/Users/mattias.johansson/.npm",
        "~/code",
        "~/Documents/notes",
        "~/.m2",
        "~/.gradle",
        "~/.cargo",
        "/tmp"
      ],
      "denyWrite": [
        "~/code/bashconfig/stow/claude/.claude",
        "~/code/bashconfig/stow/shell"
      ]
    },
    "credentials": {
      "files": [
        { "path": "~/.aws", "mode": "deny" },
        { "path": "~/.ssh", "mode": "deny" },
        { "path": "~/.config/gh", "mode": "deny" },
        { "path": "~/.cargo/credentials.toml", "mode": "deny" },
        { "path": "~/.claude/.credentials.json", "mode": "deny" },
        { "path": "~/.netrc", "mode": "deny" }
      ]
    },
    "excludedCommands": [
      "\\gh *",
      "git ls-remote *",
      "git push",
      "git push *",
      "git -C * push*",
      "git fetch*",
      "git -C * fetch*",
      "git pull*",
      "git -C * pull*"
    ]
  },
  "effortLevel": "medium",
  "tui": "fullscreen",
  "skipWorkflowUsageWarning": true,
  "editorMode": "vim",
  "autoCompactEnabled": true
}
